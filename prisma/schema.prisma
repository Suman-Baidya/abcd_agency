generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model SiteConfig {
  id              String   @id @default("1")
  
  // General
  agencyName      String   @default("ABCD Agency")
  lightLogoUrl    String?
  darkLogoUrl     String?
  faviconUrl      String?
  contactEmail    String   @default("hello@abcdagency.com")
  contactPhone    String   @default("+1 234 567 890")
  websiteUrl      String   @default("https://abcdagency.com")
  address         String   @default("Tripura, India")
  
  // Social Links
  linkedinUrl     String?
  facebookUrl     String?
  instagramUrl    String?
  youtubeUrl      String?
  twitterUrl      String?
  behanceUrl      String?
  whatsappNumber  String?
  
  // Settings
  enableWhatsappWidget Boolean @default(true)
  requireEmailVerification Boolean @default(false)
  
  updatedAt       DateTime @updatedAt
}

model User {
  id              String         @id @default(cuid())
  name            String
  companyName     String
  email           String         @unique
  password        String
  phone           String?
  isWhatsappSame  Boolean        @default(true)
  whatsapp        String?
  industry        String?
  location        String?
  website         String?
  role            String         @default("USER") // "USER" | "CLIENT" | "ADMIN" | "SUPER_ADMIN"
  status          String         @default("Active") // "Active" | "Prospect" | "Suspended"
  isVerified      Boolean        @default(false)
  isViewed        Boolean        @default(false)
  verificationOtp String?
  otpExpiresAt    DateTime?
  clientId        String?        @unique
  clientRel       Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  lastLoginAt     DateTime?
  lastLogoutAt    DateTime?
  lastActiveAt    DateTime?
  
  activities      UserActivity[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model UserActivity {
  id          String   @id @default(cuid())
  userId      String
  userRel     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String   // "REGISTER", "LOGIN", "LOGOUT", "INQUIRY_SUBMITTED", "PROFILE_UPDATED", "VIEW_SERVICES", etc.
  description String?
  ipAddress   String?
  device      String?
  createdAt   DateTime @default(now())
}

model ClientDocument {
  id          String   @id @default(cuid())
  clientId    String
  clientRel   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  fileUrl     String
  fileType    String   @default("PDF") // PDF, Image, Archive, Document
  size        String   @default("1.2 MB")
  uploadedBy  String   @default("Agency Team")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RevisionRequest {
  id          String   @id @default(cuid())
  clientId    String
  clientRel   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  projectRel  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title       String
  description String   @db.Text
  priority    String   @default("Medium") // High, Medium, Low
  status      String   @default("Pending") // Pending, In Review, In Progress, Resolved
  response    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClientMeeting {
  id          String   @id @default(cuid())
  clientId    String
  clientRel   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  date        String
  time        String
  duration    String   @default("30 mins")
  meetingLink String?
  status      String   @default("Scheduled") // Scheduled, Completed, Cancelled
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inquiry {
  id              String   @id @default(cuid())
  
  // Contact Info
  name            String
  email           String
  mobile          String
  isWhatsappSame  Boolean  @default(true)
  whatsapp        String?
  
  // Project Details
  businessType    String
  services        String[]
  projectType     String
  budget          String
  message         String   @db.Text
  
  // Admin Data
  status          String   @default("New") // New, In Progress, Replied, Closed
  priority        String   @default("Medium") // High, Medium, Low
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PricingPackage {
  id             String   @id @default(cuid())
  name           String
  targetAudience String
  subHeading     String   @default("")
  subDesc        String   @default("")
  ctaLabel       String   @default("")
  deliverables   String[]
  support        String
  timeline       String
  investment     String
  order          Int      @default(0)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PricingService {
  id               String   @id @default(cuid())
  name             String
  scope            String
  monthlyRetainer  String
  yearlyPlan       String
  order            Int      @default(0)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  
  // Public Marketing Fields
  title       String
  slug        String   @unique
  client      String
  clientId    String?
  clientRel   Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  category    String
  tagline     String
  summary     String   @db.Text
  impact      String
  techStack   String[]
  content     String   @db.Text // For the deep dive page
  isFeatured  Boolean  @default(false)
  
  // Internal Dashboard Fields
  status      String   @default("In Review")
  statusColor String   @default("neutral")
  progress    Int      @default(0)
  budget      String   @default("")
  budgetRaw   Int      @default(0)
  paidRaw     Int      @default(0)
  deadline    String   @default("")
  
  transactions     Transaction[]
  revisionRequests RevisionRequest[]
  tasks            ProjectTask[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectTask {
  id          String   @id @default(cuid())
  projectId   String
  projectRel  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  status      String   @default("Todo") // "Backlog" | "Todo" | "InProgress" | "Done" | "Approved"
  priority    String   @default("Medium") // "Urgent" | "High" | "Medium" | "Low" | "Critical"
  assignee    String?  // e.g. "Dev Lead", "UI Designer", "Suman"
  dueDate     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([priority])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id             String   @id @default(cuid())
  name           String
  contactPerson  String   @default("")
  email          String
  phone          String   @default("")
  isWhatsappSame Boolean  @default(true)
  whatsapp       String?
  industry       String   @default("")
  location       String   @default("")
  website        String?
  status         String   @default("Active") // Active, Prospect, Inactive
  totalSpend     String   @default("₹0")
  totalSpendRaw  Int      @default(0)
  dueBalance     String   @default("₹0")
  dueBalanceRaw  Int      @default(0)
  notes          String?  @db.Text
  joinedDate     DateTime @default(now())
  
  userRel          User?
  projects         Project[]
  transactions     Transaction[]
  documents        ClientDocument[]
  revisionRequests RevisionRequest[]
  meetings         ClientMeeting[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Transaction {
  id             String   @id @default(cuid())
  title          String
  type           String   @default("Income") // "Income" | "Expense"
  category       String   @default("Project Payment") // "Project Payment", "Client Retainer", etc.
  amount         String   @default("₹0")
  amountRaw      Int      @default(0)
  status         String   @default("Completed") // "Completed" | "Pending" | "Cancelled"
  date           DateTime @default(now())
  paymentMethod  String   @default("Bank Transfer") // "Bank Transfer", "UPI", "Credit Card", "Stripe", "Cash", "PayPal"
  referenceNo    String?  // Invoice / Transaction / UTR reference
  clientName     String?  // Associated client (if Income) or vendor/payee (if Expense)
  clientId       String?
  clientRel      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId      String?
  projectRel     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  notes          String?  @db.Text
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}



