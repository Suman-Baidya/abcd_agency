generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model SiteConfig {
  id              String   @id @default("1")
  
  // General
  agencyName      String   @default("ABCD Agency")
  lightLogoUrl    String?
  darkLogoUrl     String?
  faviconUrl      String?
  contactEmail    String   @default("hello@abcdagency.com")
  contactPhone    String   @default("+1 234 567 890")
  websiteUrl      String   @default("https://abcdagency.com")
  address         String   @default("Tripura, India")
  
  // Social Links
  linkedinUrl     String?
  facebookUrl     String?
  instagramUrl    String?
  youtubeUrl      String?
  twitterUrl      String?
  behanceUrl      String?
  whatsappNumber  String?
  
  // Settings
  enableWhatsappWidget Boolean @default(true)
  
  updatedAt       DateTime @updatedAt
}

model Inquiry {
  id              String   @id @default(cuid())
  
  // Contact Info
  name            String
  email           String
  mobile          String
  isWhatsappSame  Boolean  @default(true)
  whatsapp        String?
  
  // Project Details
  businessType    String
  services        String[]
  projectType     String
  budget          String
  message         String   @db.Text
  
  // Admin Data
  status          String   @default("New") // New, In Progress, Replied, Closed
  priority        String   @default("Medium") // High, Medium, Low
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PricingPackage {
  id             String   @id @default(cuid())
  name           String
  targetAudience String
  subHeading     String   @default("")
  subDesc        String   @default("")
  ctaLabel       String   @default("")
  deliverables   String[]
  support        String
  timeline       String
  investment     String
  order          Int      @default(0)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PricingService {
  id               String   @id @default(cuid())
  name             String
  scope            String
  monthlyRetainer  String
  yearlyPlan       String
  order            Int      @default(0)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  
  // Public Marketing Fields
  title       String
  slug        String   @unique
  client      String
  category    String
  tagline     String
  summary     String   @db.Text
  impact      String
  techStack   String[]
  content     String   @db.Text // For the deep dive page
  isFeatured  Boolean  @default(false)
  
  // Internal Dashboard Fields
  status      String   @default("In Review")
  statusColor String   @default("neutral")
  progress    Int      @default(0)
  budget      String   @default("")
  deadline    String   @default("")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id             String   @id @default(cuid())
  name           String
  contactPerson  String   @default("")
  email          String
  phone          String   @default("")
  isWhatsappSame Boolean  @default(true)
  whatsapp       String?
  industry       String   @default("")
  location       String   @default("")
  website        String?
  status         String   @default("Active") // Active, Prospect, Inactive
  totalSpend     String   @default("₹0")
  totalSpendRaw  Int      @default(0)
  dueBalance     String   @default("₹0")
  dueBalanceRaw  Int      @default(0)
  notes          String?  @db.Text
  joinedDate     DateTime @default(now())
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Transaction {
  id             String   @id @default(cuid())
  title          String
  type           String   @default("Income") // "Income" | "Expense"
  category       String   @default("Project Payment") // "Project Payment", "Client Retainer", "Software & Tools", "Salaries & Payroll", "Marketing & Ads", "Hosting & Cloud", "Office & Equipment", "Miscellaneous"
  amount         String   @default("₹0")
  amountRaw      Int      @default(0)
  status         String   @default("Completed") // "Completed" | "Pending" | "Cancelled"
  date           DateTime @default(now())
  paymentMethod  String   @default("Bank Transfer") // "Bank Transfer", "UPI", "Credit Card", "Stripe", "Cash", "PayPal"
  referenceNo    String?  // Invoice / Transaction / UTR reference like "INV-2026-001" or "UPI-983742"
  clientName     String?  // Associated client (if Income) or vendor/payee (if Expense)
  notes          String?  @db.Text
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}



